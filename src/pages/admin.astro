---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "文章管理";
const description = "直接在网页里新增、导入、查看和删除博客文章。";

// 这些默认值会自动填进页面里，后面如果你换仓库，改这里或在网页里改都可以。
const repoDefaults = {
	owner: "jxz7374-cell",
	repo: "Firefly",
	branch: "master",
	contentDir: "src/content/posts",
	assetDir: "public/uploads",
};

// 新文章默认使用今天日期，和博客文章常见写法保持一致。
const initialPublishedDate = new Date().toISOString().slice(0, 10);
---

<MainGridLayout title={title} description={description}>
	<Fragment slot="head">
		<meta name="robots" content="noindex,nofollow" />
	</Fragment>

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-5 py-6 md:px-9 relative w-full">
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-10 w-10 rounded-xl bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon is:inline name="material-symbols:edit-square-outline-rounded" class="text-[1.7rem]" />
					</div>
					<div>
						<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">{title}</h1>
						<p class="text-sm md:text-base text-neutral-600 dark:text-neutral-400 mt-1">
							以后你就在这个页面里新增、导入、查看、删除文章，不用再去代码文件夹里翻文章。
						</p>
					</div>
				</div>

				<div class="rounded-2xl border border-(--primary)/20 bg-(--primary)/8 px-4 py-4 text-sm md:text-[0.97rem] leading-7 text-neutral-700 dark:text-neutral-300">
					<p class="font-semibold text-(--primary)">第一次使用前，只要做这 3 步：</p>
					<p>1. 去 GitHub 创建一个个人访问令牌（Personal Access Token）。</p>
					<p>2. 给这个仓库至少开通 <code>Contents: Read and write</code> 权限。</p>
					<p>3. 把令牌粘贴到下面，保存后就能直接管理文章。</p>
					<p class="mt-2 text-xs md:text-sm opacity-80">
						安全提醒：令牌只保存在你当前浏览器本地，不会直接显示到博客前台。
					</p>
				</div>
			</div>

			<div class="grid gap-4 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
				<section class="space-y-4">
					<div class="card-base-transparent admin-panel p-5 md:p-6">
						<div class="flex items-center gap-2 mb-4">
							<Icon is:inline name="material-symbols:settings-account-box-outline-rounded" class="text-[1.5rem] text-(--primary)" />
							<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">仓库连接</h2>
						</div>

						<div class="grid gap-4 md:grid-cols-2">
							<label class="admin-field">
								<span>GitHub 用户名</span>
								<input id="admin-owner" class="admin-input" type="text" value={repoDefaults.owner} autocomplete="off" />
							</label>
							<label class="admin-field">
								<span>仓库名</span>
								<input id="admin-repo" class="admin-input" type="text" value={repoDefaults.repo} autocomplete="off" />
							</label>
							<label class="admin-field">
								<span>分支名</span>
								<input id="admin-branch" class="admin-input" type="text" value={repoDefaults.branch} autocomplete="off" />
							</label>
							<label class="admin-field">
								<span>文章目录</span>
								<input id="admin-content-dir" class="admin-input" type="text" value={repoDefaults.contentDir} autocomplete="off" />
							</label>
						</div>

						<label class="admin-field mt-4">
							<span>GitHub 令牌</span>
							<input
								id="admin-token"
								class="admin-input"
								type="password"
								placeholder="粘贴 GitHub Personal Access Token"
								autocomplete="off"
							/>
						</label>

						<div class="flex flex-wrap gap-3 mt-5">
							<button id="admin-save-settings" class="btn-regular rounded-xl px-4 py-2.5 font-semibold active:scale-95">
								保存设置
							</button>
							<button id="admin-load-posts" class="btn-card rounded-xl px-4 py-2.5 font-semibold text-(--primary) active:scale-95">
								读取文章列表
							</button>
							<button id="admin-clear-token" class="btn-card rounded-xl px-4 py-2.5 font-semibold text-(--primary) active:scale-95">
								清除令牌
							</button>
						</div>
					</div>

					<div class="card-base-transparent admin-panel p-5 md:p-6">
						<div class="flex items-center gap-2 mb-3">
							<Icon is:inline name="material-symbols:library-add-outline-rounded" class="text-[1.5rem] text-(--primary)" />
							<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">内容发布</h2>
						</div>

						<div class="rounded-2xl bg-neutral-500/5 px-4 py-4 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
							<p>这里只保留“新增文章”这一种发布方式。</p>
							<p>如果文章里要配图或放附件，直接在下面的“添加文件”里上传并插入正文就可以。</p>
						</div>

						<div class="admin-section-block mt-5">
							<div class="flex items-center gap-2 mb-4">
								<Icon is:inline name="material-symbols:post-add-rounded" class="text-[1.3rem] text-(--primary)" />
								<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">新增文章</h3>
							</div>

							<div class="rounded-2xl border border-(--line-divider) bg-neutral-500/5 p-4">
								<div class="flex items-center gap-2 mb-4">
									<Icon is:inline name="material-symbols:attach-file-add-rounded" class="text-[1.25rem] text-(--primary)" />
									<h4 class="text-base font-bold text-neutral-900 dark:text-neutral-100">添加文件</h4>
								</div>

								<div class="grid gap-4 md:grid-cols-2">
									<label class="admin-field">
										<span>上传目录</span>
										<input id="admin-upload-dir" class="admin-input" type="text" value={repoDefaults.assetDir} autocomplete="off" />
										<small class="admin-help">
											这里建议保持 <code>public/uploads</code>。因为放在 <code>public</code> 目录里的文件，上传后才能直接通过网站链接打开。
										</small>
									</label>

								<label class="admin-field">
									<span>上传后的文件名</span>
									<input
										id="any-file-name"
										class="admin-input"
										type="text"
										placeholder="单文件时可自定义，多文件时请留空"
										autocomplete="off"
									/>
									<small class="admin-help">
										如果你一次只传 1 个文件，这里可以自定义文件名。一次传多个文件时，请留空，系统会保留每个文件原名。
									</small>
								</label>
								</div>

								<label class="admin-field mt-4">
									<span>选择要插入文章的文件</span>
									<input id="any-local-file" class="admin-input admin-file-input" type="file" multiple />
									<small class="admin-help">
										图片、PDF、压缩包、Word、Excel 等文件都可以上传。支持一次选择多个文件，上传成功后会自动插入到正文里。
									</small>
								</label>

								<div class="flex flex-wrap gap-3 mt-5">
									<button id="admin-upload-any-file" class="btn-regular rounded-xl px-4 py-2.5 font-semibold active:scale-95">
										添加文件到文章
									</button>
								</div>

								<div class="mt-4 rounded-2xl bg-neutral-500/5 px-4 py-4 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
									<p>上传成功后，系统会自动把文件链接追加到下面的正文里。</p>
									<p>如果是图片，会自动插入 Markdown 图片语法；其他文件会插入下载链接。</p>
								</div>
							</div>

							<div class="grid gap-4 md:grid-cols-2 mt-5">
								<label class="admin-field md:col-span-2">
									<span>文章标题</span>
									<input id="post-title" class="admin-input" type="text" placeholder="例如：我的第一篇博客文章" autocomplete="off" />
								</label>
								<label class="admin-field">
									<span>发布日期</span>
									<input id="post-published" class="admin-input" type="date" value={initialPublishedDate} />
								</label>
								<label class="admin-field">
									<span>分类</span>
									<input id="post-category" class="admin-input" type="text" placeholder="例如：日常" autocomplete="off" />
								</label>
								<label class="admin-field md:col-span-2">
									<span>文章简介</span>
									<input id="post-description" class="admin-input" type="text" placeholder="首页列表里显示的简短说明" autocomplete="off" />
								</label>
								<label class="admin-field md:col-span-2">
									<span>标签</span>
									<input id="post-tags" class="admin-input" type="text" placeholder="多个标签用英文逗号隔开，例如：日常, 学习, 记录" autocomplete="off" />
								</label>
								<label class="admin-field md:col-span-2">
									<span>文件名</span>
									<input id="post-file-name" class="admin-input" type="text" placeholder="会根据标题自动生成，也可以自己改" autocomplete="off" />
									<small class="admin-help">这个文件名会决定文章链接地址。不想管它也没关系，输入标题后会自动生成。</small>
								</label>
								<label class="admin-check md:col-span-2">
									<input id="post-draft" type="checkbox" />
									<span>先保存为草稿，不在前台公开显示</span>
								</label>
								<label class="admin-field md:col-span-2">
									<span>正文内容</span>
									<textarea id="post-body" class="admin-textarea" rows="14" placeholder="在这里写文章正文。支持普通 Markdown 语法。"></textarea>
								</label>
							</div>

							<div class="flex flex-wrap gap-3 mt-5">
								<button id="admin-create-post" class="btn-regular rounded-xl px-4 py-2.5 font-semibold active:scale-95">
									创建文章
								</button>
								<button id="admin-fill-template" class="btn-card rounded-xl px-4 py-2.5 font-semibold text-(--primary) active:scale-95">
									填入示例正文
								</button>
							</div>
						</div>
					</div>
				</section>

				<section class="space-y-4">
					<div class="card-base-transparent admin-panel p-5 md:p-6">
						<div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
							<div class="flex items-center gap-2">
								<Icon is:inline name="material-symbols:news-outline-rounded" class="text-[1.5rem] text-(--primary)" />
								<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">当前文章</h2>
							</div>
							<button id="admin-refresh-posts" class="btn-card rounded-xl px-4 py-2.5 font-semibold text-(--primary) active:scale-95">
								刷新列表
							</button>
						</div>

						<div id="admin-status" class="admin-status" data-status-type="info">
							请先保存设置，然后点击“读取文章列表”。
						</div>

						<div class="mt-4 rounded-2xl border border-(--line-divider) overflow-hidden">
							<div class="admin-list-head">
								<span>文章</span>
								<span>操作</span>
							</div>
							<div id="admin-post-list" class="admin-post-list">
								<div class="admin-empty">
									<Icon is:inline name="material-symbols:folder-managed-outline-rounded" class="text-[2rem] text-(--primary) mb-2" />
									<p>读取成功后，这里会显示你当前博客里的文章。</p>
								</div>
							</div>
						</div>

						<div class="mt-4 rounded-2xl bg-neutral-500/5 px-4 py-4 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
							<p>新增或删除文章后，GitHub Pages 通常需要 1 到 3 分钟重新部署。</p>
							<p>如果文章已经创建成功，但列表这次刷新失败了，再点一次“刷新列表”通常就能恢复。</p>
						</div>
					</div>

					<div class="card-base-transparent admin-panel p-5 md:p-6">
						<div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
							<div class="flex items-center gap-2">
								<Icon is:inline name="material-symbols:folder-copy-outline-rounded" class="text-[1.5rem] text-(--primary)" />
								<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">已上传文件</h2>
							</div>
							<button id="admin-refresh-uploads" class="btn-card rounded-xl px-4 py-2.5 font-semibold text-(--primary) active:scale-95">
								刷新文件列表
							</button>
						</div>

						<div class="mt-4 rounded-2xl border border-(--line-divider) overflow-hidden">
							<div class="admin-list-head">
								<span>文件</span>
								<span>操作</span>
							</div>
							<div id="admin-upload-list" class="admin-post-list">
								<div class="admin-empty">
									<Icon is:inline name="material-symbols:folder-open-outline-rounded" class="text-[2rem] text-(--primary) mb-2" />
									<p>读取成功后，这里会显示你上传到网站里的附件文件。</p>
								</div>
							</div>
						</div>

						<div class="mt-4 rounded-2xl bg-neutral-500/5 px-4 py-4 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
							<p>这里显示的是上传到 <code>public</code> 目录里的站点文件，不是博客文章。</p>
							<p>删除后，这个文件的网页链接也会失效。</p>
						</div>
					</div>
				</section>
			</div>
		</div>
	</div>
</MainGridLayout>

<script
	is:inline
	define:vars={{
		repoDefaults,
		initialPublishedDate,
	}}
>
	(() => {
		const STORAGE_KEY = "nick-fox-blog-admin-settings-v2";

		// 统一收集页面上会反复用到的元素，后面代码更清楚。
		const elements = {
			status: document.getElementById("admin-status"),
			postList: document.getElementById("admin-post-list"),
			owner: document.getElementById("admin-owner"),
			repo: document.getElementById("admin-repo"),
			branch: document.getElementById("admin-branch"),
			contentDir: document.getElementById("admin-content-dir"),
			uploadDir: document.getElementById("admin-upload-dir"),
			token: document.getElementById("admin-token"),
			saveSettingsButton: document.getElementById("admin-save-settings"),
			loadPostsButton: document.getElementById("admin-load-posts"),
			clearTokenButton: document.getElementById("admin-clear-token"),
			refreshPostsButton: document.getElementById("admin-refresh-posts"),
			refreshUploadsButton: document.getElementById("admin-refresh-uploads"),
			createPostButton: document.getElementById("admin-create-post"),
			fillTemplateButton: document.getElementById("admin-fill-template"),
			postTitle: document.getElementById("post-title"),
			postPublished: document.getElementById("post-published"),
			postCategory: document.getElementById("post-category"),
			postDescription: document.getElementById("post-description"),
			postTags: document.getElementById("post-tags"),
			postFileName: document.getElementById("post-file-name"),
			postDraft: document.getElementById("post-draft"),
			postBody: document.getElementById("post-body"),
			uploadList: document.getElementById("admin-upload-list"),
			anyLocalFile: document.getElementById("any-local-file"),
			anyFileName: document.getElementById("any-file-name"),
			uploadAnyFileButton: document.getElementById("admin-upload-any-file"),
		};

		let fileNameTouchedByUser = false;

		function setStatus(message, type = "info") {
			if (!elements.status) return;
			elements.status.textContent = message;
			elements.status.setAttribute("data-status-type", type);
		}

		function setButtonBusy(button, loadingText, isBusy) {
			if (!button) return;
			if (!button.dataset.defaultText) {
				button.dataset.defaultText = button.textContent || "";
			}

			button.disabled = isBusy;
			button.classList.toggle("opacity-70", isBusy);
			button.classList.toggle("cursor-not-allowed", isBusy);
			button.textContent = isBusy ? loadingText : button.dataset.defaultText;
		}

		function readSettingsFromForm() {
			return {
				owner: elements.owner?.value.trim() || repoDefaults.owner,
				repo: elements.repo?.value.trim() || repoDefaults.repo,
				branch: elements.branch?.value.trim() || repoDefaults.branch,
				contentDir: elements.contentDir?.value.trim() || repoDefaults.contentDir,
				assetDir: elements.uploadDir?.value.trim() || repoDefaults.assetDir,
				token: elements.token?.value.trim() || "",
			};
		}

		function validateSettings(settings) {
			if (!settings.owner || !settings.repo || !settings.branch || !settings.contentDir) {
				throw new Error("仓库信息没有填写完整。");
			}
			if (!settings.token) {
				throw new Error("请先粘贴 GitHub 令牌。");
			}
		}

		function saveSettingsToBrowser() {
			const settings = readSettingsFromForm();
			localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
			setStatus("设置已经保存到当前浏览器。", "success");
		}

		function loadSavedSettings() {
			const savedText = localStorage.getItem(STORAGE_KEY);
			if (!savedText) return;

			try {
				const saved = JSON.parse(savedText);
				if (elements.owner) elements.owner.value = saved.owner || repoDefaults.owner;
				if (elements.repo) elements.repo.value = saved.repo || repoDefaults.repo;
				if (elements.branch) elements.branch.value = saved.branch || repoDefaults.branch;
				if (elements.contentDir) {
					elements.contentDir.value = saved.contentDir || repoDefaults.contentDir;
				}
				if (elements.uploadDir) {
					elements.uploadDir.value = saved.assetDir || repoDefaults.assetDir;
				}
				if (elements.token) elements.token.value = saved.token || "";
			} catch (error) {
				console.warn("无法读取已保存的后台设置。", error);
			}
		}

		function clearSavedToken() {
			const settings = readSettingsFromForm();
			settings.token = "";
			localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
			if (elements.token) {
				elements.token.value = "";
			}
			setStatus("令牌已经清除。", "info");
		}

		// GitHub API 遇到中文正文时，普通 btoa 不够用，所以这里手动转成 UTF-8。
		function encodeBase64Utf8(text) {
			const bytes = new TextEncoder().encode(text);
			let binary = "";
			bytes.forEach((byte) => {
				binary += String.fromCharCode(byte);
			});
			return btoa(binary);
		}

		// 任意文件可能是图片或压缩包，不能按文本读取，所以这里单独处理二进制内容。
		function encodeBase64Bytes(bytes) {
			let binary = "";
			const chunkSize = 0x8000;

			for (let index = 0; index < bytes.length; index += chunkSize) {
				const chunk = bytes.subarray(index, index + chunkSize);
				binary += String.fromCharCode(...chunk);
			}

			return btoa(binary);
		}

		function decodeBase64Utf8(text) {
			const cleanText = text.replace(/\s+/g, "");
			const binary = atob(cleanText);
			const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
			return new TextDecoder().decode(bytes);
		}

		function encodeRepoPath(path) {
			return path
				.split("/")
				.filter(Boolean)
				.map((segment) => encodeURIComponent(segment))
				.join("/");
		}

		function normalizeDisplayValue(value) {
			return String(value || "").replace(/^['"]|['"]$/g, "").trim();
		}

		function normalizeDateValue(value) {
			const cleaned = String(value || "").trim().replace(/\//g, "-");
			const match = cleaned.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
			if (!match) return "";
			const [, year, month, day] = match;
			return `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
		}

		// 目录只允许普通相对路径，避免误传到奇怪的位置。
		function normalizeDirectoryPath(pathText, fallbackValue, options = {}) {
			const { requirePublic = false } = options;
			const fallback = String(fallbackValue || "").trim();
			const rawValue = String(pathText || fallback).trim().replace(/\\/g, "/");
			const segments = rawValue
				.split("/")
				.map((item) => item.trim())
				.filter(Boolean);

			if (segments.length === 0) {
				throw new Error("上传目录不能为空。");
			}

			if (segments.some((item) => item === "." || item === "..")) {
				throw new Error("上传目录里不能包含 . 或 .. 这样的路径写法。");
			}

			const normalized = segments.join("/");
			if (requirePublic && normalized !== "public" && !normalized.startsWith("public/")) {
				throw new Error("任意文件上传目录必须放在 public 开头的目录里，例如 public/uploads。");
			}

			return normalized;
		}

		function parseTitleFromMarkdown(markdownText, filePath) {
			const titleMatch = markdownText.match(/^title:\s*(.+)$/m);
			return normalizeDisplayValue(titleMatch?.[1]) || filePath.split("/").pop() || filePath;
		}

		function parsePublishedFromMarkdown(markdownText) {
			const publishedMatch = markdownText.match(/^published:\s*(.+)$/m);
			return normalizeDateValue(normalizeDisplayValue(publishedMatch?.[1]));
		}

		function splitTags(tagText) {
			return tagText
				.split(",")
				.map((item) => item.trim())
				.filter(Boolean);
		}

		function buildExampleBody() {
			return `## 开头
今天想记录一点自己的内容。

## 正文

- 第一件事
- 第二件事
- 第三件事

## 结尾

写完后点击“创建文章”，等 GitHub Pages 部署完成就能在前台看到。`;
		}

		// 这个函数负责把标题变成比较安全的文件名，避免出现特殊字符。
		function safeFileNamePart(text) {
			return text
				.trim()
				.replace(/[\\/:*?"<>|#%&{}$!@+=`~]/g, "")
				.replace(/\s+/g, "-")
				.replace(/-+/g, "-")
				.replace(/^\.+|\.+$/g, "");
		}

		function suggestFileName() {
			const title = elements.postTitle?.value.trim() || "";
			const published = elements.postPublished?.value || initialPublishedDate;
			const safeTitle = safeFileNamePart(title);

			if (!safeTitle) {
				return `${published}-new-post.md`;
			}

			return `${published}-${safeTitle}.md`;
		}

		function normalizeFileName(fileName) {
			let cleaned = fileName.trim().replace(/\\/g, "/");
			cleaned = cleaned.split("/").filter(Boolean).pop() || "";
			cleaned = safeFileNamePart(cleaned);

			if (!cleaned) {
				throw new Error("文件名不能为空。");
			}

			if (!/\.(md|mdx)$/i.test(cleaned)) {
				cleaned += ".md";
			}

			return cleaned;
		}

		function normalizeAssetFileName(fileName) {
			let cleaned = String(fileName || "").trim().replace(/\\/g, "/");
			cleaned = cleaned.split("/").filter(Boolean).pop() || "";
			cleaned = safeFileNamePart(cleaned);

			if (!cleaned) {
				throw new Error("上传后的文件名不能为空。");
			}

			return cleaned;
		}

		function escapeHtml(text) {
			return String(text)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		function escapeAttribute(text) {
			return escapeHtml(text);
		}

		function wait(ms) {
			return new Promise((resolve) => {
				window.setTimeout(resolve, ms);
			});
		}

		function getUploadDirFromSettings(settings) {
			return normalizeDirectoryPath(settings.assetDir, repoDefaults.assetDir, {
				requirePublic: true,
			});
		}

		function getSiteBasePath() {
			const currentPath = window.location.pathname;

			if (currentPath.endsWith("/admin/")) {
				return currentPath.slice(0, -"/admin/".length) || "/";
			}

			if (currentPath.endsWith("/admin")) {
				return currentPath.slice(0, -"/admin".length) || "/";
			}

			return "/";
		}

		function joinUrlPath(basePath, childPath) {
			const safeBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
			const safeChild = String(childPath || "").replace(/^\/+/, "");
			return `${safeBase}${safeChild}`.replace(/\/{2,}/g, "/");
		}

		function buildPublicFileUrl(repoPath) {
			const siteRelativePath = String(repoPath || "").replace(/^public\/+/, "");
			const sitePath = joinUrlPath(getSiteBasePath(), siteRelativePath);
			return `${window.location.origin}${sitePath}`;
		}

		function isImageFile(fileName) {
			return /\.(avif|gif|jpe?g|png|svg|webp)$/i.test(fileName);
		}

		function buildAttachmentMarkdown(fileUrl, fileName) {
			const safeLabel = String(fileName || "附件").replace(/\]/g, "\\]");
			const safeUrl = String(fileUrl || "").replace(/\)/g, "%29");
			return isImageFile(fileName) ? `![${safeLabel}](${safeUrl})` : `[${safeLabel}](${safeUrl})`;
		}

		function appendAttachmentToPostBody(fileUrl, fileName) {
			if (!(elements.postBody instanceof HTMLTextAreaElement)) return "";

			const snippet = buildAttachmentMarkdown(fileUrl, fileName);
			const currentValue = elements.postBody.value.trimEnd();
			elements.postBody.value = currentValue ? `${currentValue}\n\n${snippet}` : snippet;
			elements.postBody.focus();
			return snippet;
		}

		function appendAttachmentsToPostBody(files) {
			if (!(elements.postBody instanceof HTMLTextAreaElement) || files.length === 0) return "";

			const snippets = files
				.map((file) => buildAttachmentMarkdown(file.url, file.name))
				.join("\n\n");
			const currentValue = elements.postBody.value.trimEnd();
			elements.postBody.value = currentValue ? `${currentValue}\n\n${snippets}` : snippets;
			elements.postBody.focus();
			return snippets;
		}

		function normalizeAdminError(error, fallbackMessage) {
			if (error instanceof DOMException && error.name === "AbortError") {
				return "连接 GitHub 超时了。可以等几秒后再试一次。";
			}

			if (error instanceof TypeError && /Failed to fetch/i.test(error.message)) {
				return "浏览器这次没连上 GitHub。通常只是网络波动，不一定代表文章没创建成功。";
			}

			return error instanceof Error ? error.message : fallbackMessage;
		}

		async function fetchGithubResponse(settings, endpoint, options = {}) {
			const controller = new AbortController();
			const timeoutId = window.setTimeout(() => controller.abort(), 20000);

			try {
				return await fetch(
					`https://api.github.com/repos/${encodeURIComponent(settings.owner)}/${encodeURIComponent(settings.repo)}${endpoint}`,
					{
						...options,
						signal: controller.signal,
						headers: {
							Accept: "application/vnd.github+json",
							Authorization: `Bearer ${settings.token}`,
							"X-GitHub-Api-Version": "2022-11-28",
							...(options.headers || {}),
						},
					},
				);
			} finally {
				window.clearTimeout(timeoutId);
			}
		}

		async function githubRequest(settings, endpoint, options = {}) {
			let response;

			// 网络偶尔抖一下时，自动再试一次，减少误报。
			for (let attempt = 0; attempt < 2; attempt++) {
				try {
					response = await fetchGithubResponse(settings, endpoint, options);
					break;
				} catch (error) {
					const isRetryableNetworkError =
						error instanceof TypeError ||
						(error instanceof DOMException && error.name === "AbortError");

					if (!isRetryableNetworkError || attempt === 1) {
						throw error;
					}

					await wait(800);
				}
			}

			if (response.status === 204) {
				return null;
			}

			const responseText = await response.text();
			const data = responseText ? JSON.parse(responseText) : null;

			if (!response.ok) {
				throw new Error(data?.message || "请求 GitHub API 失败。");
			}

			return data;
		}

		async function fetchRepositoryTree(settings) {
			const branchRef = await githubRequest(
				settings,
				`/git/ref/heads/${encodeURIComponent(settings.branch)}`,
			);
			const commitInfo = await githubRequest(settings, `/git/commits/${branchRef.object.sha}`);
			const treeInfo = await githubRequest(
				settings,
				`/git/trees/${commitInfo.tree.sha}?recursive=1`,
			);

			return treeInfo.tree || [];
		}

		function getUploadedFilesFromTree(tree, uploadDir) {
			return tree
				.filter((item) => item.type === "blob" && item.path.startsWith(`${uploadDir}/`))
				.map((item) => {
					const fileName = item.path.split("/").pop() || item.path;
					return {
						name: fileName,
						path: item.path,
						sha: item.sha,
						url: buildPublicFileUrl(item.path),
					};
				})
				.sort((a, b) => a.path.localeCompare(b.path));
		}

		async function fetchSinglePostMeta(settings, filePath) {
			const fileInfo = await githubRequest(
				settings,
				`/contents/${encodeRepoPath(filePath)}?ref=${encodeURIComponent(settings.branch)}`,
			);
			const markdownText = fileInfo.content ? decodeBase64Utf8(fileInfo.content) : "";

			return {
				path: filePath,
				sha: fileInfo.sha,
				title: parseTitleFromMarkdown(markdownText, filePath),
				published: parsePublishedFromMarkdown(markdownText),
			};
		}

		async function fetchExistingFileSha(settings, filePath) {
			const response = await fetchGithubResponse(
				settings,
				`/contents/${encodeRepoPath(filePath)}?ref=${encodeURIComponent(settings.branch)}`,
			);

			if (response.status === 404) {
				return "";
			}

			const responseText = await response.text();
			const data = responseText ? JSON.parse(responseText) : null;

			if (!response.ok) {
				throw new Error(data?.message || "检查文件是否已存在时失败。");
			}

			return data?.sha || "";
		}

		function renderPosts(posts) {
			if (!elements.postList) return;

			if (posts.length === 0) {
				elements.postList.innerHTML = `
					<div class="admin-empty">
						<p>目前还没有文章，你可以先创建第一篇。</p>
					</div>
				`;
				return;
			}

			elements.postList.innerHTML = posts
				.map((post) => {
					const publishedText = post.published
						? `<div class="admin-post-meta">发布日期：${escapeHtml(post.published)}</div>`
						: "";

					return `
						<div class="admin-post-row">
							<div class="admin-post-main">
								<div class="admin-post-title">${escapeHtml(post.title)}</div>
								<div class="admin-post-path">${escapeHtml(post.path)}</div>
								${publishedText}
							</div>
							<div class="admin-post-actions">
								<button
									type="button"
									class="btn-card rounded-xl px-4 py-2 text-red-500 hover:text-red-600 active:scale-95"
									data-delete-path="${escapeAttribute(post.path)}"
									data-delete-sha="${escapeAttribute(post.sha)}"
									data-delete-title="${escapeAttribute(post.title)}"
								>
									删除
								</button>
							</div>
						</div>
					`;
				})
				.join("");
		}

		function renderUploadedFiles(files) {
			if (!elements.uploadList) return;

			if (files.length === 0) {
				elements.uploadList.innerHTML = `
					<div class="admin-empty">
						<p>当前上传目录里还没有文件，你可以先上传一个试试。</p>
					</div>
				`;
				return;
			}

			elements.uploadList.innerHTML = files
				.map((file) => {
					return `
						<div class="admin-post-row">
							<div class="admin-post-main">
								<div class="admin-post-title">${escapeHtml(file.name)}</div>
								<div class="admin-post-path">${escapeHtml(file.path)}</div>
								<div class="admin-post-meta">
									<a
										href="${escapeAttribute(file.url)}"
										target="_blank"
										rel="noreferrer"
										class="underline underline-offset-4"
									>
										打开文件链接
									</a>
								</div>
							</div>
							<div class="admin-post-actions">
								<button
									type="button"
									class="btn-card rounded-xl px-4 py-2 text-red-500 hover:text-red-600 active:scale-95"
									data-delete-upload-path="${escapeAttribute(file.path)}"
									data-delete-upload-sha="${escapeAttribute(file.sha)}"
									data-delete-upload-name="${escapeAttribute(file.name)}"
								>
									删除
								</button>
							</div>
						</div>
					`;
				})
				.join("");
		}

		function buildMarkdownContent() {
			const title = elements.postTitle?.value.trim() || "";
			const published = elements.postPublished?.value || initialPublishedDate;
			const description = elements.postDescription?.value.trim() || "";
			const category = elements.postCategory?.value.trim() || "";
			const tags = splitTags(elements.postTags?.value || "");
			const isDraft = Boolean(elements.postDraft?.checked);
			const body = elements.postBody?.value.trim() || "请在这里开始写正文。";

			return `---
title: ${JSON.stringify(title)}
published: ${published}
description: ${JSON.stringify(description)}
tags: ${JSON.stringify(tags)}
category: ${JSON.stringify(category)}
draft: ${isDraft}
lang: "zh_CN"
---

${body}
`;
		}

		async function readSelectedGenericFiles() {
			const input = elements.anyLocalFile;
			if (!(input instanceof HTMLInputElement) || !input.files || input.files.length === 0) {
				throw new Error("请先选择至少一个要上传的本地文件。");
			}

			return Promise.all(
				Array.from(input.files).map(async (file) => {
					const buffer = await file.arrayBuffer();
					return {
						file,
						bytes: new Uint8Array(buffer),
					};
				}),
			);
		}

		async function loadPosts(options = {}) {
			const settings = readSettingsFromForm();
			const {
				afterCreate = false,
				afterDelete = false,
				afterAssetUpload = false,
				afterAssetDelete = false,
			} = options;

			try {
				validateSettings(settings);
				const uploadDir = getUploadDirFromSettings(settings);
				setButtonBusy(elements.loadPostsButton, "读取中...", true);
				setButtonBusy(elements.refreshPostsButton, "刷新中...", true);
				setButtonBusy(elements.refreshUploadsButton, "刷新中...", true);
				setStatus("正在读取 GitHub 上的文章列表...", "info");

				const tree = await fetchRepositoryTree(settings);
				const files = tree.filter((item) => {
					return (
						item.type === "blob" &&
						item.path.startsWith(`${settings.contentDir}/`) &&
						/\.(md|mdx)$/i.test(item.path)
					);
				});
				const postMetaResults = await Promise.allSettled(
					files.map((file) => fetchSinglePostMeta(settings, file.path)),
				);
				const postMetaList = postMetaResults
					.filter((result) => result.status === "fulfilled")
					.map((result) => result.value);
				const failedCount = postMetaResults.length - postMetaList.length;

				postMetaList.sort((a, b) => {
					const dateA = a.published || "";
					const dateB = b.published || "";
					return dateA < dateB ? 1 : dateA > dateB ? -1 : a.path.localeCompare(b.path);
				});

				renderPosts(postMetaList);
				const uploadedFiles = getUploadedFilesFromTree(tree, uploadDir);
				renderUploadedFiles(uploadedFiles);

				if (failedCount > 0) {
					setStatus(
						`文章列表已经刷新，但有 ${failedCount} 篇文章的详细信息这次没读到。你再点一次“刷新列表”通常就能恢复。`,
						"warning",
					);
					return;
				}

				if (afterCreate) {
					setStatus(`文章已经创建成功了，当前列表里一共看到 ${postMetaList.length} 篇文章。`, "success");
					return;
				}

				if (afterDelete) {
					setStatus(`文章已经删除成功了，当前列表里还剩 ${postMetaList.length} 篇文章。`, "success");
					return;
				}

				if (afterAssetUpload) {
					setStatus(
						`文件已经上传成功了。现在上传目录里共有 ${uploadedFiles.length} 个文件，可以直接点“打开文件链接”查看。`,
						"success",
					);
					return;
				}

				if (afterAssetDelete) {
					setStatus(`文件已经删除成功了。现在上传目录里还剩 ${uploadedFiles.length} 个文件。`, "success");
					return;
				}

				setStatus(
					`读取完成，现在一共找到 ${postMetaList.length} 篇文章，上传目录里有 ${uploadedFiles.length} 个文件。`,
					"success",
				);
			} catch (error) {
				console.error(error);
				const message = normalizeAdminError(error, "读取后台列表失败。");

				if (afterCreate) {
					setStatus(`文章其实已经创建成功了，只是刷新列表时出了点问题：${message}`, "warning");
					return;
				}

				if (afterDelete) {
					setStatus(`文章其实已经删除成功了，只是刷新列表时出了点问题：${message}`, "warning");
					return;
				}

				if (afterAssetUpload) {
					setStatus(`文件其实已经上传成功了，只是刷新文件列表时出了点问题：${message}`, "warning");
					return;
				}

				if (afterAssetDelete) {
					setStatus(`文件其实已经删除成功了，只是刷新文件列表时出了点问题：${message}`, "warning");
					return;
				}

				setStatus(message, "error");
			} finally {
				setButtonBusy(elements.loadPostsButton, "读取中...", false);
				setButtonBusy(elements.refreshPostsButton, "刷新中...", false);
				setButtonBusy(elements.refreshUploadsButton, "刷新中...", false);
			}
		}

		async function createPost() {
			const settings = readSettingsFromForm();

			try {
				validateSettings(settings);

				const title = elements.postTitle?.value.trim() || "";
				if (!title) {
					throw new Error("请先填写文章标题。");
				}

				const fileName = normalizeFileName(
					elements.postFileName?.value.trim() || suggestFileName(),
				);
				const filePath = `${settings.contentDir}/${fileName}`;
				const markdownContent = buildMarkdownContent();

				setButtonBusy(elements.createPostButton, "创建中...", true);
				setStatus("正在把新文章写入 GitHub 仓库...", "info");

				await githubRequest(settings, `/contents/${encodeRepoPath(filePath)}`, {
					method: "PUT",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						message: `feat: add post ${title}`,
						content: encodeBase64Utf8(markdownContent),
						branch: settings.branch,
					}),
				});

				fileNameTouchedByUser = false;
				if (elements.postFileName) {
					elements.postFileName.value = suggestFileName();
				}
				await loadPosts({ afterCreate: true });
			} catch (error) {
				console.error(error);
				setStatus(normalizeAdminError(error, "创建文章失败。"), "error");
			} finally {
				setButtonBusy(elements.createPostButton, "创建中...", false);
			}
		}

		async function uploadGenericFile() {
			const settings = readSettingsFromForm();

			try {
				validateSettings(settings);
				const uploadDir = getUploadDirFromSettings(settings);
				const selectedFiles = await readSelectedGenericFiles();
				const customFileName = elements.anyFileName?.value.trim() || "";

				if (selectedFiles.length > 1 && customFileName) {
					throw new Error("一次上传多个文件时，请把“上传后的文件名”留空，系统会自动保留每个文件自己的名字。");
				}

				setButtonBusy(elements.uploadAnyFileButton, "上传中...", true);
				setStatus(
					selectedFiles.length === 1
						? "正在把这个文件上传到 GitHub 仓库..."
						: `正在把 ${selectedFiles.length} 个文件上传到 GitHub 仓库...`,
					"info",
				);

				const uploadedFiles = [];
				for (const { file, bytes } of selectedFiles) {
					const fileName = normalizeAssetFileName(customFileName || file.name);
					const filePath = `${uploadDir}/${fileName}`;
					const fileUrl = buildPublicFileUrl(filePath);
					const existingSha = await fetchExistingFileSha(settings, filePath);

					await githubRequest(settings, `/contents/${encodeRepoPath(filePath)}`, {
						method: "PUT",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							message: `feat: upload file ${fileName}`,
							content: encodeBase64Bytes(bytes),
							branch: settings.branch,
							...(existingSha ? { sha: existingSha } : {}),
						}),
					});

					uploadedFiles.push({
						name: fileName,
						url: fileUrl,
					});
				}

				appendAttachmentsToPostBody(uploadedFiles);
				await loadPosts({ afterAssetUpload: true });
				setStatus(
					selectedFiles.length === 1
						? `附件上传成功，已经把链接插入到正文里：${uploadedFiles[0]?.url || ""}`
						: ` ${selectedFiles.length} 个文件上传成功，链接已经按顺序插入到正文里。`.trim(),
					"success",
				);
			} catch (error) {
				console.error(error);
				setStatus(normalizeAdminError(error, "上传任意文件失败。"), "error");
			} finally {
				setButtonBusy(elements.uploadAnyFileButton, "上传中...", false);
			}
		}

		async function deleteRepositoryFile(path, sha, title, kind) {
			const settings = readSettingsFromForm();

			try {
				validateSettings(settings);

				const confirmed = window.confirm(
					`确定要删除这个${kind}吗？\n\n${title}\n${path}\n\n删除后，仓库里的这个文件会被直接移除。`,
				);

				if (!confirmed) {
					return;
				}

				setStatus(`正在删除《${title}》...`, "info");

				await githubRequest(settings, `/contents/${encodeRepoPath(path)}`, {
					method: "DELETE",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						message: kind === "文章" ? `chore: delete post ${title}` : `chore: delete file ${title}`,
						sha,
						branch: settings.branch,
					}),
				});

				if (kind === "文章") {
					await loadPosts({ afterDelete: true });
					return;
				}

				await loadPosts({ afterAssetDelete: true });
			} catch (error) {
				console.error(error);
				const fallbackMessage = kind === "文章" ? "删除文章失败。" : "删除文件失败。";
				setStatus(normalizeAdminError(error, fallbackMessage), "error");
			}
		}

		async function deletePost(path, sha, title) {
			return deleteRepositoryFile(path, sha, title, "文章");
		}

		async function deleteUploadedFile(path, sha, fileName) {
			return deleteRepositoryFile(path, sha, fileName, "文件");
		}

		function bindDeleteButtons() {
			const bindDeleteList = (container) => {
				if (!container) return;

				container.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;

					const deleteButton = target.closest("[data-delete-path]");
					if (deleteButton) {
						const path = deleteButton.getAttribute("data-delete-path") || "";
						const sha = deleteButton.getAttribute("data-delete-sha") || "";
						const title = deleteButton.getAttribute("data-delete-title") || "未命名文章";

						if (!path || !sha) return;
						deletePost(path, sha, title);
						return;
					}

					const deleteUploadButton = target.closest("[data-delete-upload-path]");
					if (!deleteUploadButton) return;

					const path = deleteUploadButton.getAttribute("data-delete-upload-path") || "";
					const sha = deleteUploadButton.getAttribute("data-delete-upload-sha") || "";
					const fileName = deleteUploadButton.getAttribute("data-delete-upload-name") || "未命名文件";

					if (!path || !sha) return;
					deleteUploadedFile(path, sha, fileName);
				});
			};

			bindDeleteList(elements.postList);
			bindDeleteList(elements.uploadList);
		}

		function bindFileNameSuggestion() {
			if (!elements.postFileName || !elements.postTitle || !elements.postPublished) return;

			const syncSuggestedName = () => {
				if (fileNameTouchedByUser) return;
				elements.postFileName.value = suggestFileName();
			};

			elements.postTitle.addEventListener("input", syncSuggestedName);
			elements.postPublished.addEventListener("input", syncSuggestedName);

			elements.postFileName.addEventListener("input", () => {
				const currentValue = elements.postFileName.value.trim();
				fileNameTouchedByUser = currentValue.length > 0 && currentValue !== suggestFileName();
			});

			syncSuggestedName();
		}

		function bindTemplateButton() {
			if (!elements.fillTemplateButton || !elements.postBody) return;

			elements.fillTemplateButton.addEventListener("click", () => {
				if (!elements.postBody.value.trim()) {
					elements.postBody.value = buildExampleBody();
				} else {
					elements.postBody.value = `${elements.postBody.value.trim()}\n\n${buildExampleBody()}`;
				}
			});
		}

		function bindLocalFileHelpers() {
			if (elements.anyLocalFile instanceof HTMLInputElement) {
				elements.anyLocalFile.addEventListener("change", () => {
					const files = elements.anyLocalFile.files;
					if (!files || files.length === 0) return;

					if (!(elements.anyFileName instanceof HTMLInputElement)) return;
					if (files.length > 1) {
						elements.anyFileName.value = "";
						elements.anyFileName.placeholder = "已选择多个文件，请留空保留各自原名";
						return;
					}

					elements.anyFileName.placeholder = "单文件时可自定义，多文件时请留空";
					if (!elements.anyFileName.value.trim()) {
						elements.anyFileName.value = files[0].name;
					}
				});
			}
		}

		function bindActions() {
			elements.saveSettingsButton?.addEventListener("click", saveSettingsToBrowser);
			elements.loadPostsButton?.addEventListener("click", () => loadPosts());
			elements.refreshPostsButton?.addEventListener("click", () => loadPosts());
			elements.refreshUploadsButton?.addEventListener("click", () => loadPosts());
			elements.clearTokenButton?.addEventListener("click", clearSavedToken);
			elements.createPostButton?.addEventListener("click", createPost);
			elements.uploadAnyFileButton?.addEventListener("click", uploadGenericFile);
		}

		function init() {
			loadSavedSettings();
			bindActions();
			bindDeleteButtons();
			bindFileNameSuggestion();
			bindTemplateButton();
			bindLocalFileHelpers();

			const savedText = localStorage.getItem(STORAGE_KEY);
			if (!savedText) return;

			try {
				const saved = JSON.parse(savedText);
				if (saved.token) {
					loadPosts();
				}
			} catch (error) {
				console.warn("自动读取后台设置失败。", error);
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}
	})();
</script>

